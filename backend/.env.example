SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-another-long-random-value
DATABASE_URL=sqlite:///instance/faceclass.db
# MySQL example: mysql+pymysql://faceclass:password@localhost/faceclass
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=ml/models/model.keras
MODEL_METADATA_PATH=ml/models/metadata.json
MOCK_MODE=false
INFERENCE_BACKEND=opencv_caffe
GENDER_MODEL_PATH=ml/models/gender_net.caffemodel
GENDER_PROTO_PATH=ml/models/gender_deploy.prototxt
RETAIN_IMAGES=false
MAX_UPLOAD_MB=10
JWT_ACCESS_TOKEN_MINUTES=30
RATELIMIT_STORAGE_URI=memory://
# For production redis: redis://redis:6379/0
AUTO_CREATE_SCHEMA=true
DEMO_ACCOUNTS=true
FACE_DETECTOR_PATH=ml/models/face_detection_yunet_2023mar.onnx
FACE_MARGIN=0.15
MALE_THRESHOLD=0.8
