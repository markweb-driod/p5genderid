MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_SECRET_KEY=replace-with-a-different-32-byte-secret
DATABASE_URL=mysql+pymysql://faceclass:replace-with-a-strong-database-password@mysql/faceclass
FRONTEND_ORIGIN=https://faceclass.example.com
MODEL_PATH=/app/ml/models/model.keras
MODEL_METADATA_PATH=/app/ml/models/metadata.json
MOCK_MODE=false
INFERENCE_BACKEND=opencv_caffe
GENDER_MODEL_PATH=/app/ml/models/gender_net.caffemodel
GENDER_PROTO_PATH=/app/ml/models/gender_deploy.prototxt
RETAIN_IMAGES=false
MAX_UPLOAD_MB=10
JWT_ACCESS_TOKEN_MINUTES=30
RATELIMIT_STORAGE_URI=redis://redis:6379/0
AUTO_CREATE_SCHEMA=false
